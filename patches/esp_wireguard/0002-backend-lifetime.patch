+// A Wi-Fi netif can disappear before the owner task drains its offline event.
+// Resolve the bound index before dereferencing a cached underlay pointer.
+static struct netif *wireguardif_live_underlay(struct wireguard_device *device) {
+    struct netif *current = netif_get_by_index(device->udp_pcb->netif_idx);
+    return current && current == device->underlying_netif && netif_is_up(current) &&
+        netif_is_link_up(current) ? current : NULL;
+}
