+// Copyright 2026 Neon-Dolls/neondoll-embedded
+// SPDX-License-Identifier: BSD-3-Clause
+#ifndef NEONDOLL_IP6_H
+#define NEONDOLL_IP6_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+// Contiguous network-order masks only. Zero/default prefixes are forbidden.
+static inline int nd_mask_bits(const uint8_t *mask, size_t bytes) {
+    int bits = 0;
+    bool zero = false;
+    for (size_t i = 0; i < bytes; ++i) {
+        for (unsigned bit = 0x80; bit; bit >>= 1) {
+            if (mask[i] & bit) { if (zero) return -1; ++bits; }
+            else zero = true;
+        }
+    }
+    return bits ? bits : -1;
+}
+static inline bool nd_prefix_match(const uint8_t *ip, const uint8_t *network,
+                            const uint8_t *mask, size_t bytes) {
+    if (nd_mask_bits(mask, bytes) < 0) return false;
+    for (size_t i = 0; i < bytes; ++i)
+        if ((ip[i] & mask[i]) != (network[i] & mask[i])) return false;
+    return true;
+}
+// Caller provides at least the first 40 bytes when bytes >= 40. Extension header
+// semantics remain with lwIP. No jumbograms; at most 15 bytes WG receive padding.
+static inline size_t nd_ip6_length(const uint8_t *header, size_t bytes, bool padded) {
+    if (bytes < 40 || (header[0] >> 4) != 6) return 0;
+    size_t payload = ((size_t)header[4] << 8) | header[5];
+    size_t length = 40 + payload;
+    if (!payload && header[6] == 0) return 0; // Jumbo option unsupported.
+    if (length > 65535 || length > bytes || bytes - length > (padded ? 15u : 0u)) return 0;
+    return length;
+}
+#endif
